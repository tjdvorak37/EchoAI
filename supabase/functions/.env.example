# Secrets for the Supabase Edge Functions that run the billing automation.
# Set them with: supabase secrets set --env-file supabase/functions/.env.example
# Never commit real values. STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY must
# never be exposed to the browser.

STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_endpoint
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_ANNUAL=price_annual_id

# Referral discounts for the referred customer. Both must be duration=once
# coupons in Stripe so the discount never carries into later renewals.
# 20% off the first month, and 10% off the first year.
STRIPE_COUPON_REFERRAL_MONTHLY=coupon_20pct_once_id
STRIPE_COUPON_REFERRAL_ANNUAL=coupon_10pct_once_id

# Days of continued access after a failed charge while Stripe retries.
BILLING_GRACE_DAYS=3

# Used for checkout redirects and CORS.
APP_URL=https://app.example.com

# Injected automatically by Supabase when deployed; needed only for local serve.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
