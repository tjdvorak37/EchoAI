# Secrets for the Supabase Edge Functions that run the billing automation.
# Set them with: supabase secrets set --env-file supabase/functions/.env.example
# Never commit real values. STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY must
# never be exposed to the browser.

STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_endpoint

# One Stripe price per tier per interval. Annual prices are 15% off 12 months.
# Standard        2 GB    $29/mo   $295/yr
# Storage +       10 GB   $39/mo   $398/yr
# Storage Pro     25 GB   $59/mo   $599/yr
# Storage Max     50 GB   $89/mo   $899/yr
# Creator Studio  100 GB  $129/mo  $1299/yr
STRIPE_PRICE_STANDARD_MONTHLY=price_1UFGJ9RrklQsqC822EUTvcKQ
STRIPE_PRICE_STANDARD_ANNUAL=price_1UFGJ9RrklQsqC823cmY2TfS
STRIPE_PRICE_STORAGE_PLUS_MONTHLY=price_1UFGHxRrklQsqC820fmti9kY
STRIPE_PRICE_STORAGE_PLUS_ANNUAL=price_1UFGHxRrklQsqC820FuI8teb
STRIPE_PRICE_STORAGE_PRO_MONTHLY=price_1UFGGdRrklQsqC825AahS61v
STRIPE_PRICE_STORAGE_PRO_ANNUAL=price_1UFGGdRrklQsqC82PLtdTqAr
STRIPE_PRICE_STORAGE_MAX_MONTHLY=price_1UFGEiRrklQsqC82jSx1SMxs
STRIPE_PRICE_STORAGE_MAX_ANNUAL=price_1UFGEiRrklQsqC82kFKGekg3
STRIPE_PRICE_CREATOR_MONTHLY=price_1UFGCRRrklQsqC82vjVbVkuJ
STRIPE_PRICE_CREATOR_ANNUAL=price_1UFGCRRrklQsqC82NfiDNVOW

# Token Add-On Packages (One-Time Payments)
# 500 AI Tokens    $9.99
# 1,000 AI Tokens  $18.99
# 2,500 AI Tokens  $39.99
# 5,000 AI Tokens  $74.99
STRIPE_PRICE_CREDIT_500=price_1UFGcbRrklQsqC82iY7GVtDr
STRIPE_PRICE_CREDIT_1000=price_1UFGdRRrklQsqC82fUcEFFP3
STRIPE_PRICE_CREDIT_2500=price_1UFGeBRrklQsqC82JMP7nUXL
STRIPE_PRICE_CREDIT_5000=price_1UFGeqRrklQsqC82fuiF4ksA

# Referral discounts for the referred customer. Both must be duration=once
# coupons in Stripe so the discount never carries into later renewals.
# 20% off the first month, and 10% off the first year.
STRIPE_COUPON_REFERRAL_MONTHLY=coupon_20pct_once_id
STRIPE_COUPON_REFERRAL_ANNUAL=coupon_10pct_once_id

# Days of continued access after a failed charge while Stripe retries.
BILLING_GRACE_DAYS=3

# Used for checkout redirects and CORS.
APP_URL=https://app.example.com

# Injected automatically by Supabase when deployed; needed only for local serve.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Image generation, proxied by the ai-image function.
# These were previously VITE_ variables, which shipped them to every browser.
IMAGE_GEN_ENDPOINT=https://your-image-provider.example.com/generate
IMAGE_GEN_API_KEY=your-provider-key
IMAGE_GEN_MODEL=image-1

# Social listening custom connectors, proxied by the listening-fetch function.
# These are optional upgrades. EchoAI's managed open-web sources work without
# them, so users only need to choose search terms and source types.
LISTENING_SOCIAL_ENDPOINT=
LISTENING_SOCIAL_API_KEY=
LISTENING_NEWS_ENDPOINT=
LISTENING_NEWS_API_KEY=
LISTENING_FORUMS_ENDPOINT=
LISTENING_FORUMS_API_KEY=
LISTENING_BLOGS_ENDPOINT=
LISTENING_BLOGS_API_KEY=
LISTENING_REVIEWS_ENDPOINT=
LISTENING_REVIEWS_API_KEY=
LISTENING_WEB_ENDPOINT=
LISTENING_WEB_API_KEY=

# Cloud drive connections. Register the redirect URI as:
#   https://<project-ref>.supabase.co/functions/v1/cloud-drive
# Google:    console.cloud.google.com -> OAuth client (Drive API enabled)
# Microsoft: entra.microsoft.com -> App registration (Files.Read.All, Sites.Read.All)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Self-service social account authorization. Register this callback URL with
# Meta and Google: https://<project-ref>.supabase.co/functions/v1/social-oauth
# Meta supports Facebook Pages and Instagram Professional accounts. YouTube
# requires the YouTube Data API to be enabled for the Google OAuth project.
META_CLIENT_ID=
META_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202501

# A long random value used only by the trusted scheduler that invokes
# social-publisher. Never expose this value to browser code.
SOCIAL_PUBLISHER_CRON_SECRET=
